{
  "project_id": "example_project",
  "purpose": "기존 final 덮어쓰기 방지와 final 후보/승인본 구분을 위한 registry",
  "versioning_rule": "Never overwrite existing final files. Save revised finals as a new version.",
  "episodes": [
    {
      "episode": 1,
      "status": "pending_user_review",
      "current_final_candidate": "episodes/episode_001_final_v1.md",
      "approved_final": null,
      "final_versions": [
        {
          "version": "v1",
          "path": "episodes/episode_001_final_v1.md",
          "status": "candidate / approved / rejected / superseded",
          "created_from": "episode_001_revision_note_v1.md",
          "created_at": "YYYY-MM-DD",
          "do_not_overwrite": true,
          "notes": "기준본 설명"
        }
      ]
    }
  ],
  "integrity_rules": {
    "episode_status_must_match_registry": true,
    "approved_final_is_read_only": true,
    "new_revision_requires_new_version": true,
    "mismatch_requires_recovery_plan": true,
    "status_registry_sync_required_before_completion": true,
    "new_version_requires_revision_note": true
  },
  "preflight_check": {
    "must_compare_episode_status_before_final_work": true,
    "must_list_existing_final_files_before_new_version": true,
    "existing_final_files_are_read_only": true,
    "mismatch_halt_reason_code": "FINAL_REGISTRY_STATUS_MISMATCH"
  }
}
